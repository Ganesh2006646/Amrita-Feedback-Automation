{
  "manifest_version": 3,
  "name": "AutoFeed - Amrita Feedback",
  "version": "2.0.0",
  "description": "AutoFeed automates Amrita class and course feedback with Outlook OTP support.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://students.amrita.edu/*",
    "*://*.cloud.microsoft/*",
    "*://*.office.com/*",
    "*://*.office365.com/*",
    "*://*.outlook.com/*",
    "*://*.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://students.amrita.edu/*"],
      "js": ["amrita.js"],
      "css": ["widget.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://students.amrita.edu/*"],
      "js": ["dialog-overrides.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.cloud.microsoft/*",
        "*://*.office.com/*",
        "*://*.office365.com/*",
        "*://*.outlook.com/*",
        "*://*.live.com/*"
      ],
      "js": ["outlook.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AutoFeed - Amrita Feedback",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
